# Base de données (optionnel en local : sans ces variables, le fichier data/africa-agro-sem.db est utilisé)
# En ligne sur Vercel, utilisez une base Turso :
DATABASE_URL=libsql://votre-base.turso.io
DATABASE_AUTH_TOKEN=votre-jeton
# Secret de signature des sessions (optionnel : sinon généré et stocké dans la base)
SESSION_SECRET=
